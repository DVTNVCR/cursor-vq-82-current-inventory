@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'Serial Numbers per Delivery Item'
@VDM.viewType: #BASIC
@Metadata.allowExtensions: true

define view entity ZI_DeliverySerial
  as select from ser03 as h
    inner join objk as o
      on o.obknr = h.obknr
{
  key h.lief_nr    as DeliveryDocument,
  key h.posnr      as DeliveryDocumentItem,
  key o.equnr      as Equipment,
      o.sernr      as SerialNumber,
      o.matnr      as Product
}
where o.taser = 'SER01'
