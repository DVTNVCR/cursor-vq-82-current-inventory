@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'Patient Ship-Tos from Deliveries'
@VDM.viewType: #BASIC

define view entity ZI_PatientShipTo
  as select distinct from I_DeliveryDocument
{
  key SoldToParty   as Patient,
  key ShipToParty   as ShipTo
}
where ActualGoodsMovementDate is not initial
