@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'Serial Customer Assignments'
@VDM.viewType: #BASIC

define view entity ZI_SerialCurrentCustomer
  as select distinct from ser01 as s
    inner join objk as o
      on o.obknr = s.obknr
{
  key o.equnr    as Equipment,
  key s.kunde    as Customer
}
where o.taser = 'SER01'
